<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Palette MonEmploi -->
    <Color x:Key="Primaire">#1F4E79</Color>
    <Color x:Key="PrimaireFonce">#163A5C</Color>
    <Color x:Key="PrimaireClair">#DCE8F4</Color>
    <Color x:Key="Accent">#F2A541</Color>
    <Color x:Key="Succes">#2E8B57</Color>
    <Color x:Key="SuccesClair">#E3F3EA</Color>
    <Color x:Key="Danger">#C0392B</Color>
    <Color x:Key="DangerClair">#FBE7E5</Color>
    <Color x:Key="Avertissement">#B9770E</Color>
    <Color x:Key="AvertissementClair">#FDF2DC</Color>

    <Color x:Key="Fond">#F4F6FA</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="Bordure">#E1E6EE</Color>
    <Color x:Key="Texte">#1B2430</Color>
    <Color x:Key="TexteSecondaire">#5E6B7D</Color>

    <SolidColorBrush x:Key="PrimaireBrush" Color="#1F4E79" />
    <SolidColorBrush x:Key="BordureBrush" Color="#E1E6EE" />

</ResourceDictionary>
