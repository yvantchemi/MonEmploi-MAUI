<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Styles implicites -->
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource Fond}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Texte}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource Texte}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TexteSecondaire}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{StaticResource Texte}" />
        <Setter Property="TitleColor" Value="{StaticResource TexteSecondaire}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="TimePicker">
        <Setter Property="TextColor" Value="{StaticResource Texte}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Primaire}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <!-- Styles nommés -->
    <Style x:Key="BoutonSecondaire" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource PrimaireClair}" />
        <Setter Property="TextColor" Value="{StaticResource Primaire}" />
    </Style>

    <Style x:Key="BoutonDanger" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource DangerClair}" />
        <Setter Property="TextColor" Value="{StaticResource Danger}" />
    </Style>

    <Style x:Key="BoutonMini" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource DangerClair}" />
        <Setter Property="TextColor" Value="{StaticResource Danger}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinimumHeightRequest" Value="32" />
        <Setter Property="HeightRequest" Value="34" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="Carte" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="Stroke" Value="{StaticResource BordureBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style x:Key="TitreSection" TargetType="Label">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource Primaire}" />
    </Style>

    <Style x:Key="TitreCarte" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource Texte}" />
    </Style>

    <Style x:Key="TexteDiscret" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource TexteSecondaire}" />
    </Style>

    <Style x:Key="EnTeteJour" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource Primaire}" />
        <Setter Property="Margin" Value="4,14,0,6" />
    </Style>

    <!-- Shell -->
    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource Primaire}" />
        <Setter Property="Shell.ForegroundColor" Value="White" />
        <Setter Property="Shell.TitleColor" Value="White" />
        <Setter Property="Shell.DisabledColor" Value="#7F9AB5" />
        <Setter Property="Shell.UnselectedColor" Value="#B9CCE0" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource Primaire}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource Primaire}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource TexteSecondaire}" />
    </Style>

</ResourceDictionary>
