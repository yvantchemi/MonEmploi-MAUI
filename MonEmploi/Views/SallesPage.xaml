<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MonEmploi.ViewModels"
             x:Class="MonEmploi.Views.SallesPage"
             Title="Salles">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16,12" RowSpacing="10">

        <!-- Formulaire -->
        <Border Style="{StaticResource Carte}">
            <VerticalStackLayout Spacing="8">
                <Label Text="Nouvelle salle" Style="{StaticResource TitreCarte}" />
                <Entry Placeholder="Nom (ex. Salle 103)" Text="{Binding Nom}" />
                <Grid ColumnDefinitions="*,110" ColumnSpacing="8">
                    <Entry Placeholder="Bâtiment" Text="{Binding Batiment}" />
                    <Entry Grid.Column="1" Placeholder="Capacité" Keyboard="Numeric" Text="{Binding Capacite}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Button Text="{Binding TexteBouton}" Command="{Binding EnregistrerCommand}" />
                    <Button Grid.Column="1" Text="Annuler" Style="{StaticResource BoutonSecondaire}"
                            Command="{Binding AnnulerCommand}" IsVisible="{Binding EnModification}" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <Label Grid.Row="1" Text="Salles disponibles — touchez une salle pour la modifier"
               Style="{StaticResource TexteDiscret}" />

        <!-- Liste -->
        <CollectionView Grid.Row="2" ItemsSource="{Binding Salles}"
                        SelectionMode="Single" SelectedItem="{Binding Selection}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <Label Text="Aucune salle enregistrée." HorizontalOptions="Center" Margin="0,30" Style="{StaticResource TexteDiscret}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Carte}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Nom}" Style="{StaticResource TitreCarte}" />
                                <Label Text="{Binding Details}" Style="{StaticResource TexteDiscret}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Supprimer" Style="{StaticResource BoutonMini}" VerticalOptions="Center"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SallesViewModel}}, Path=SupprimerCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
