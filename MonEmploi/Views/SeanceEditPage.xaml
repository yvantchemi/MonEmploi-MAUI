<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonEmploi.Views.SeanceEditPage"
             Title="{Binding Titre}">

    <ScrollView>
        <VerticalStackLayout Padding="16,12" Spacing="12">

            <!-- Cours -->
            <Border Style="{StaticResource Carte}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Cours" Style="{StaticResource TitreSection}" />
                    <Entry Placeholder="Matière (ex. Programmation C#)" Text="{Binding Matiere}" />
                    <Picker Title="Enseignant" ItemsSource="{Binding Enseignants}"
                            ItemDisplayBinding="{Binding NomComplet}" SelectedItem="{Binding EnseignantChoisi}" />
                    <Picker Title="Groupe" ItemsSource="{Binding Groupes}"
                            ItemDisplayBinding="{Binding Nom}" SelectedItem="{Binding GroupeChoisi}" />
                    <Picker Title="Salle" ItemsSource="{Binding Salles}"
                            ItemDisplayBinding="{Binding Nom}" SelectedItem="{Binding SalleChoisie}" />
                </VerticalStackLayout>
            </Border>

            <!-- Créneau -->
            <Border Style="{StaticResource Carte}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Créneau" Style="{StaticResource TitreSection}" />
                    <Picker Title="Jour" ItemsSource="{Binding JoursNoms}" SelectedIndex="{Binding JourIndex}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout>
                            <Label Text="Début" Style="{StaticResource TexteDiscret}" />
                            <TimePicker Time="{Binding Debut}" Format="HH:mm" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Fin" Style="{StaticResource TexteDiscret}" />
                            <TimePicker Time="{Binding Fin}" Format="HH:mm" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Vérification des conflits -->
            <Border Style="{StaticResource Carte}" BackgroundColor="{StaticResource SuccesClair}" IsVisible="{Binding SansConflit}">
                <Label Text="{Binding Etat}" TextColor="{StaticResource Succes}" FontAttributes="Bold" />
            </Border>

            <Border Style="{StaticResource Carte}" BackgroundColor="{StaticResource DangerClair}" IsVisible="{Binding AConflits}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding Etat}" TextColor="{StaticResource Danger}" FontAttributes="Bold" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Conflits}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="{Binding Libelle}" FontAttributes="Bold" TextColor="{StaticResource Danger}" FontSize="13" />
                                    <Label Text="{Binding Message}" FontSize="13" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Actions -->
            <Button Text="Enregistrer la séance" Command="{Binding EnregistrerCommand}" />
            <Button Text="Annuler" Style="{StaticResource BoutonSecondaire}" Command="{Binding AnnulerCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
