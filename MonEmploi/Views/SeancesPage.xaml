<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MonEmploi.ViewModels"
             x:Class="MonEmploi.Views.SeancesPage"
             Title="Séances">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16,12" RowSpacing="6">

        <!-- Recherche et filtre -->
        <Border Style="{StaticResource Carte}" Padding="8,4">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                <SearchBar Placeholder="Matière, enseignant, groupe, salle…" Text="{Binding Recherche}" />
                <Label Grid.Column="1" Text="Conflits" VerticalOptions="Center" Style="{StaticResource TexteDiscret}" />
                <Switch Grid.Column="2" IsToggled="{Binding ConflitsSeulement}" OnColor="{StaticResource Danger}" VerticalOptions="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <VerticalStackLayout VerticalOptions="Center">
                <Label Text="{Binding Resume}" Style="{StaticResource TexteDiscret}" />
                <Label Text="Touchez une séance pour la modifier" Style="{StaticResource TexteDiscret}" FontSize="12" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="+ Nouvelle séance" Command="{Binding NouvelleCommand}" />
        </Grid>

        <CollectionView x:Name="ListeSeances" Grid.Row="2" ItemsSource="{Binding SeancesParJour}" IsGrouped="True"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="Aucune séance. Ajoutez la première avec « + Nouvelle séance »."
                       HorizontalOptions="Center" Margin="0,30" Style="{StaticResource TexteDiscret}" />
            </CollectionView.EmptyView>

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <Label Text="{Binding EnTete}" Style="{StaticResource EnTeteJour}" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Carte}" Margin="0,0,0,8">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SeancesViewModel}}, Path=OuvrirCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="6,*" ColumnSpacing="12">
                            <BoxView Color="{Binding CouleurStatut}" CornerRadius="3" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Horaire}" FontAttributes="Bold" TextColor="{StaticResource Primaire}" />
                                    <Label Grid.Column="1" Text="⚠ Conflit" FontAttributes="Bold" FontSize="12"
                                           TextColor="{StaticResource Danger}" IsVisible="{Binding EnConflit}" />
                                </Grid>
                                <Label Text="{Binding Matiere}" Style="{StaticResource TitreCarte}" />
                                <Label Text="{Binding Participants}" Style="{StaticResource TexteDiscret}" />
                                <Label Text="{Binding Lieu}" Style="{StaticResource TexteDiscret}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
