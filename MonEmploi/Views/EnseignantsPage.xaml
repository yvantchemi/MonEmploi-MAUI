<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MonEmploi.ViewModels"
             x:Class="MonEmploi.Views.EnseignantsPage"
             Title="Enseignants">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16,12" RowSpacing="10">

        <Border Style="{StaticResource Carte}">
            <VerticalStackLayout Spacing="8">
                <Label Text="Nouvel enseignant" Style="{StaticResource TitreCarte}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Entry Placeholder="Nom" Text="{Binding Nom}" />
                    <Entry Grid.Column="1" Placeholder="Prénom" Text="{Binding Prenom}" />
                </Grid>
                <Entry Placeholder="Spécialité (ex. Réseaux)" Text="{Binding Specialite}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Button Text="{Binding TexteBouton}" Command="{Binding EnregistrerCommand}" />
                    <Button Grid.Column="1" Text="Annuler" Style="{StaticResource BoutonSecondaire}"
                            Command="{Binding AnnulerCommand}" IsVisible="{Binding EnModification}" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <Label Grid.Row="1" Text="Corps enseignant — touchez un nom pour le modifier"
               Style="{StaticResource TexteDiscret}" />

        <CollectionView Grid.Row="2" ItemsSource="{Binding Enseignants}"
                        SelectionMode="Single" SelectedItem="{Binding Selection}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <Label Text="Aucun enseignant enregistré." HorizontalOptions="Center" Margin="0,30" Style="{StaticResource TexteDiscret}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Carte}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding NomComplet}" Style="{StaticResource TitreCarte}" />
                                <Label Text="{Binding Details}" Style="{StaticResource TexteDiscret}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Supprimer" Style="{StaticResource BoutonMini}" VerticalOptions="Center"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EnseignantsViewModel}}, Path=SupprimerCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
