<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:MonEmploi.Views"
       x:Class="MonEmploi.AppShell"
       Title="MonEmploi">

    <TabBar>
        <Tab Title="Accueil" Icon="icon_accueil.png">
            <ShellContent Title="Accueil" Route="accueil" ContentTemplate="{DataTemplate views:AccueilPage}" />
        </Tab>
        <Tab Title="Séances" Icon="icon_seances.png">
            <ShellContent Title="Séances" Route="seances" ContentTemplate="{DataTemplate views:SeancesPage}" />
        </Tab>
        <Tab Title="Planning" Icon="icon_planning.png">
            <ShellContent Title="Planning" Route="planning" ContentTemplate="{DataTemplate views:PlanningPage}" />
        </Tab>
        <Tab Title="Ressources" Icon="icon_ressources.png">
            <ShellContent Title="Salles" Route="salles" ContentTemplate="{DataTemplate views:SallesPage}" />
            <ShellContent Title="Enseignants" Route="enseignants" ContentTemplate="{DataTemplate views:EnseignantsPage}" />
            <ShellContent Title="Groupes" Route="groupes" ContentTemplate="{DataTemplate views:GroupesPage}" />
        </Tab>
    </TabBar>

</Shell>
