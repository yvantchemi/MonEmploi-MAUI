<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:MonEmploi.Views"
       x:Class="MonEmploi.AppShell"
       Title="MonEmploi">

    <TabBar>
        <Tab Title="Ressources" Icon="icon_ressources.png">
            <ShellContent Title="Salles" Route="salles" ContentTemplate="{DataTemplate views:SallesPage}" />
            <ShellContent Title="Enseignants" Route="enseignants" ContentTemplate="{DataTemplate views:EnseignantsPage}" />
            <ShellContent Title="Groupes" Route="groupes" ContentTemplate="{DataTemplate views:GroupesPage}" />
        </Tab>
    </TabBar>

</Shell>
